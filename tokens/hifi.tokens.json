  "type": {
    "label": {
      "size": 12,
      "weight": 500,
      "tracking": "0.16em",
      "case": "upper"
    },
    "desk": {
      "body": 15,
      "label": 13,
      "min": 12
    },
    "kiosk": {
      "body": 18,
      "min": 12
    },
    "tv": {
      "body": 26,
      "min": 22
    }
  },
  "radius": {
    "card": 14,
    "button": 10,
    "rocker": 8,
    "band": 18
  },
  "texture": {
    "ribs": {
      "line": 1,
      "period": 10,
      "opacity": 0.07
    },
    "level": "rich",
    "paperHeadlines": true
  },
  "motion": {
    "easing": {
      "glide": "cubic-bezier(.2,.8,.2,1)",
      "decelerate": "cubic-bezier(.16,1,.3,1)",
      "settle": "cubic-bezier(.3,1.3,.5,1)",
      "leave": "cubic-bezier(.4,0,1,1)"
    },
    "ms": {
      "focus": 150,
      "press": 120,
      "menu": 200,
      "rocker": 260,
      "lightIn": 420,
      "lightOut": 180,
      "screen": 350,
      "shutter": 1400,
      "scene": 600,
      "focusTv": 150,
      "focusRepeatTv": 80,
      "signatureIn": 600,
      "signatureOut": 300
    },
    "note": "lightIn/lightOut and shutter are for signature moments on TV; anything tied to focus lights within focusTv."
  },
  "tvSelector": {
    "window": "base",
    "lit": 0.85,
    "spill": "pre-drawn bitmap per tile width, faded by opacity",
    "lift": "drawn inside the tile layer; focus rect never moves",
    "labelFocus": "warm cream colour step <=150 ms, no glyph glow"
  },
  "tv": {
    "ground": "flat band colour behind scrolling rows",
    "ribs": "fixed surfaces only, cached bitmap per size",
    "glow": "pre-rendered sprites, opacity 0->1",
    "dayPalette": "optional, mid-light, never paper-white"
  },
  "titleCard": {
    "style": "shutter",
    "progress": "slatted",
    "minHoldMs": 1600,
    "accent": "stripes"
  }
}